<!-- REGISTRO DE VEHÍCULOS -->

<section id="registro" class="container py-5">

    <h2 class="text-center text-primary mb-4">
        Registro de Vehículos
    </h2>

    <form id="formProducto">

        <div class="row">

            <div class="col-md-6 mb-3">

                <label class="form-label">
                    Placa
                </label>

                <input
                    type="text"
                    id="nombre"
                    class="form-control"
                    placeholder="Ejemplo: GSA-1234">

                <small
                    id="errorNombre"
                    class="text-danger">
                </small>

            </div>

            <div class="col-md-6 mb-3">

                <label class="form-label">
                    Tipo de Vehículo
                </label>

                <select
                    id="categoria"
                    class="form-control">

                    <option value="">
                        Seleccione
                    </option>

                    <option>
                        Camión
                    </option>

                    <option>
                        Furgón
                    </option>

                    <option>
                        Camioneta
                    </option>

                    <option>
                        Motocicleta
                    </option>

                </select>

                <small
                    id="errorCategoria"
                    class="text-danger">
                </small>

            </div>

        </div>

        <div class="mb-3">

            <label class="form-label">
                Descripción
            </label>

            <textarea
                id="descripcion"
                class="form-control"
                rows="3"
                placeholder="Descripción del vehículo"></textarea>

            <small
                id="errorDescripcion"
                class="text-danger">
            </small>

        </div>

        <button
            class="btn btn-success"
            type="submit">

            Registrar Vehículo

        </button>

    </form>

    <div id="mensaje" class="mt-3"></div>

    <!-- Spinner -->

    <div
        id="spinner"
        class="text-center mt-4"
        style="display:none;">

        <div
            class="spinner-border text-primary">

        </div>

    </div>

    <hr>

    <h4>

        Vehículos registrados:

        <span id="total">

            0

        </span>

    </h4>

    <div
        id="listaProductos"
        class="row">

    </div>

</section>

